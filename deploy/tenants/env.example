# Per-tenant environment. Lives beside the backend it configures:
#   /srv/tenants/<name>/backend/.env
#   sudo chown root:hrms /srv/tenants/<name>/backend/.env
#   sudo chmod 640 /srv/tenants/<name>/backend/.env
#
# Every value here is per organisation. Nothing is shared between tenants —
# that is the whole point of a file per tenant.

# ---- identity -------------------------------------------------------------
# Must be unique per tenant; two tenants on one port will not both start.
#   heard 3000 (the existing Rad portal) · skntheory 3001 · movment 3002
PORT=3001
HOST=127.0.0.1

# ---- database -------------------------------------------------------------
# This organisation's own database. Take it from the project's Vercel
# environment variables so the existing data is picked up rather than a new
# empty database being created. Check the db name at the end of the URI.
MONGODB_URI=

# ---- sessions -------------------------------------------------------------
# Reuse the value from Vercel. A new secret is safe but signs everyone out,
# because existing session tokens stop verifying. Password hashes are stored
# separately and are unaffected either way.
JWT_SECRET=

# Frontend and API share one origin on a subdomain, so the cookie does not
# need to ride cross-site. Lax removes the CSRF exposure that None carries.
COOKIE_SAMESITE=lax

# Same origin, so CORS is not in play. Leave empty.
CORS_ORIGIN=

# ---- uploads --------------------------------------------------------------
# Outside the code directory, so a deploy never wipes employee documents.
# Must match ReadWritePaths in hrms-tenant@.service.
UPLOADS_DIR=/var/lib/hrms/__TENANT__/uploads

# ---- attendance geofence --------------------------------------------------
# This organisation's own office. Getting these wrong marks staff as outside
# the office and breaks check-in, so confirm them per company rather than
# copying another tenant's.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_KM=

# ---- optional integrations ------------------------------------------------
# Only if this organisation actually uses Wingman. Leave empty otherwise.
WINGMAN_URL=
WINGMAN_SECRET=
