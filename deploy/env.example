# Copy to /srv/hrms/backend/.env, fill in, then:
#   sudo chown hrms:hrms /srv/hrms/backend/.env && sudo chmod 600 /srv/hrms/backend/.env
#
# systemd reads this file directly, so use KEY=value with no "export" and no
# surrounding quotes unless the value genuinely contains them.

# ---- required ----------------------------------------------------------
# Same Atlas cluster as before. Remember to allow this droplet's IP under
# Atlas -> Network Access, otherwise every request fails as "no data".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/hrms?retryWrites=true&w=majority

# Reuse the existing value, otherwise everyone is logged out on cutover.
JWT_SECRET=

# ---- single-domain settings -------------------------------------------
# The whole point of moving to one domain: Lax cookies instead of None, which
# removes the cross-site CSRF exposure. Do not set this back to "none" unless
# the frontend is served from a different origin again.
COOKIE_SAMESITE=lax

# Frontend and API share an origin, so no cross-origin requests are expected.
# Leave it set to the site itself rather than unset, because an unset value
# makes the server reflect any origin back.
CORS_ORIGIN=https://nowhrms.com

PORT=3000
HOST=127.0.0.1

# ---- uploads -----------------------------------------------------------
# Outside the git checkout, so a deploy never wipes employee documents.
# Must match ReadWritePaths in hrms-backend.service.
UPLOADS_DIR=/var/lib/hrms/uploads

# ---- attendance reporting ---------------------------------------------
# Defaults shown; uncomment only to change them.
# REPORT_UTC_OFFSET_MINUTES=300     # PKT, UTC+5
# WORK_WEEK_DAYS=1,2,3,4,5          # Mon-Fri
# MAX_SHIFT_HOURS=14                # longer sessions are treated as incomplete

# ---- office geofence (optional) ---------------------------------------
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_KM=0.5

# ---- Wingman desktop agent --------------------------------------------
# The Vercel proxy at frontend/api/wingman/clock.ts does not exist on this
# setup. Point the agent straight at https://nowhrms.com/api/wingman/clock
WINGMAN_URL=
# The company endpoint Wingman gives for employee-notification forwarding
# (project/task assigned, leave decided, payslip issued). Same secret.
WINGMAN_NOTIFY_URL=
WINGMAN_SECRET=

# ---- unfinished shifts ------------------------------------------------
# Sessions nobody clocked out of are closed automatically this many hours
# after clock-in, and flagged so reports still show them as a missed
# clock-out. Defaults to 12; the sweep runs every 15 minutes.
MAX_SESSION_HOURS=12
SHIFT_SWEEP_INTERVAL_MINUTES=15

# ---- Wingman (additions) ----------------------------------------------
# WINGMAN_URL above is the per-user event webhook Wingman gives you. It
# carries a private token: keep it in this file only, never in source -
# this repository is public. WINGMAN_SECRET must match Wingman's byte for byte.
#
# Who Wingman clocks when a request does not name an employee: an employee
# id or an email. Left empty, such a request is refused rather than guessed.
WINGMAN_DEFAULT_EMPLOYEE=
# How long to wait on Wingman's webhook. A person's own clock never waits.
WINGMAN_WEBHOOK_TIMEOUT_MS=5000

# --- Now workspace screens (all optional; these are the defaults) ---
# When the working day starts, office-local HH:MM, and how many minutes after
# that still count as on time. Used for "late arrivals" on the Time page.
# SHIFT_START_TIME=10:00
# LATE_GRACE_MINUTES=15
# Leave days per calendar year, shown as "Leave left".
# LEAVE_QUOTA_ANNUAL=14
# LEAVE_QUOTA_CASUAL=10
# LEAVE_QUOTA_SICK=8

# --- Website sign-ups by email (optional) ---
# Leads are always saved and shown in the portal under Admin > Leads. To also
# email each one, set a mail service key plus the two addresses lines. Sent over
# HTTPS, because DigitalOcean blocks SMTP. Brevo is used when BREVO_API_KEY is
# set, otherwise Resend. The "from" address must be a verified sender there.
# BREVO_API_KEY=
# RESEND_API_KEY=
# LEADS_FROM_EMAIL=Now <leads@example.com>
# LEADS_NOTIFY_EMAILS=first@example.com,second@example.com
# The person who signs up also gets the welcome email (once per address).
# Replies go to LEADS_REPLY_TO, or else the first LEADS_NOTIFY_EMAILS address.
# WELCOME_CTA_URL is the button (e.g. a booking page); without it the button
# opens a reply. WELCOME_EMAIL=off stops the welcome email.
# LEADS_REPLY_TO=
# WELCOME_CTA_URL=
# EMAIL_ASSET_BASE_URL=https://nowhrms.com/email/images
# WELCOME_EMAIL=on
